<h1 class="mb-4">Lista de Contactos</h1>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each contactos}}
        <tr>
            <td>{{this.nombre}}</td>
            <td>{{this.telefono}}</td>
            <td>{{this.email}}</td>
            <td>
                <a href="#" class="btn btn-sm btn-warning">Editar</a>
                <a href="#" class="btn btn-sm btn-danger">Borrar</a>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<a href="/agregar" class="btn btn-primary mt-3">Agregar Nuevo Contacto</a>